{
  "manifest_version": 3,
  "name": "WhatsApp Chooser",
  "version": "1.1",
  "key": "",
  "description": "Choose between WhatsApp and WhatsApp Business when opening a WhatsApp link",
  "permissions": [
    "webNavigation",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://wa.me/*",
    "https://api.whatsapp.com/*",
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["chooser.html", "chooser.css", "chooser.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
